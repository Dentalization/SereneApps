PORT=4000
DATABASE_URL=postgres://serene:serene@localhost:5432/serene
JWT_SECRET=replace-with-a-long-random-secret

# DeepDental proxy
# The browser must call /py-api/api/v1 through this backend and must not receive
# this key through any VITE_* or other client-exposed environment variable.
DEEPDENTAL_API_BASE_URL=http://127.0.0.1:8000
DEEPDENTAL_API_KEY=replace-with-server-side-deepdental-key

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_HASH_SECRET=replace-with-a-dedicated-otp-secret
OTP_EMAIL_DEPRECATED=true
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
OTP_IP_WINDOW_SECONDS=3600
OTP_IP_MAX_REQUESTS=20
OTP_IDENTIFIER_WINDOW_SECONDS=3600
OTP_IDENTIFIER_MAX_REQUESTS=5
OTP_DEV_RETURN_CODE=false

# Comma separated list of allowed origins for CORS
# Add all frontend hosts that will call this API
CORS_ORIGINS=http://localhost:4028,https://www.sereneai.com,https://dentist.sereneai.com
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_MOCK_MODE=true

# Notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@sereneai.test
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WEBHOOK_BASE_URL=https://ISI_NGROK_KAMU.ngrok-free.app/v1/webhooks
# Local development may leave this false only when using non-public callbacks.
# Staging and production must set true; the backend also enforces signatures automatically for APP_ENV/NODE_ENV staging|production.
TWILIO_WEBHOOK_REQUIRE_SIGNATURE=false
COMM_WAITING_ROOM_EARLY_MINUTES=15
COMM_WAITING_ROOM_GRACE_MINUTES=60
COMM_INVITE_BASE_URL=http://localhost:4028/communications/invite
COMM_INVITE_HASH_SECRET=replace-with-a-dedicated-invite-token-pepper
COMM_RETENTION_WORKER_INTERVAL_MS=900000
COMM_ATTACHMENT_STORAGE_DRIVER=local-private
COMM_ATTACHMENT_BUCKET=serene-chat-attachments
COMM_ATTACHMENTS_LOCAL_ROOT=
COMM_ATTACHMENT_SIGNING_SECRET=replace-with-a-dedicated-attachment-url-secret
COMM_ATTACHMENT_SIGNED_URL_TTL_SECONDS=300
COMM_ATTACHMENT_RETENTION_DAYS=365
COMM_ATTACHMENTS_MALWARE_SCAN_URL=
COMM_ATTACHMENT_S3_REGION=ap-southeast-1
COMM_ATTACHMENT_S3_ENDPOINT=
COMM_ATTACHMENT_S3_FORCE_PATH_STYLE=false
COMM_ATTACHMENT_S3_ACCESS_KEY_ID=
COMM_ATTACHMENT_S3_SECRET_ACCESS_KEY=
COMM_ATTACHMENT_S3_SESSION_TOKEN=
CLINIC_ADMIN_CAN_VIEW_CLINICAL_SUMMARY=true
TWILIO_SMS_FROM_NUMBER=
TWILIO_FROM_NUMBER=
FCM_SERVICE_ACCOUNT_JSON=
EXPO_PUSH_ENABLED=true
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_BASE64=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=300

# Appointment guardrails
APPOINTMENT_RESCHEDULE_CUTOFF_HOURS=24
APPOINTMENT_CANCEL_CUTOFF_HOURS=12
APPOINTMENT_CANCELLATION_FEE_PERCENT=0
