generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                             BigInt                     @id @default(autoincrement())
  name                                                           String
  email                                                          String                     @unique
  password_hash                                                  String
  roles                                                          String[]                   @default([])
  createdAt                                                      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  phone_number                                                   String?
  about                                                          String?
  avatar_url                                                     String?
  clinic_id                                                      BigInt?
  lastLoginAt                                                    DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  aiAnalysisResults                                              AIAnalysisResult[]
  aiChatMessages                                                 AIChatMessage[]
  appointmentStatusHistory                                       AppointmentStatusHistory[]
  dentistAppointments                                            Appointment[]              @relation("DentistAppointments")
  patientAppointments                                            Appointment[]              @relation("PatientAppointments")
  chatMessages                                                   ChatMessage[]
  chatRoomMemberships                                            ChatRoomMember[]
  clinicProfile                                                  ClinicProfile[]
  clinicStaff                                                    ClinicStaff?
  dentist_emr_records_dentist_emr_records_dentist_idTousers      dentist_emr_records[]      @relation("dentist_emr_records_dentist_idTousers")
  dentist_emr_records_dentist_emr_records_patient_user_idTousers dentist_emr_records[]      @relation("dentist_emr_records_patient_user_idTousers")
  dentistProfile                                                 DentistProfile[]
  scheduleEntries                                                DentistScheduleEntry[]
  dentistStudies                                                 ImagingStudy[]             @relation("DentistStudies")
  patientStudies                                                 ImagingStudy[]             @relation("PatientStudies")
  notificationDevices                                            NotificationDevice[]
  notificationJobs                                               NotificationJob[]
  notificationPreferences                                        NotificationPreference[]
  notifications                                                  Notification[]
  patientProfile                                                 PatientProfile?
  paymentIntents                                                 PaymentIntent[]
  ownedPaymentIntents                                            PaymentIntent[]              @relation("PaymentIntentOwnerDentist")
  financialLedgerEntries                                         FinancialLedgerEntry[]       @relation("FinancialLedgerDentist")
  ownedInvoices                                                  Invoice[]                   @relation("InvoiceOwnerDentist")
  invoices                                                       Invoice[]
  refreshTokens                                                  RefreshToken[]
  user_devices                                                   UserDevice[]
  createdTreatmentPlans                                          TreatmentPlan[]            @relation("DentistTreatmentPlans")
  patientTreatmentPlans                                          TreatmentPlan[]            @relation("PatientTreatmentPlans")
  createdStudyAnnotations                                        StudyAnnotation[]          @relation("StudyAnnotationCreator")
  reviewedStudyAnnotations                                       StudyAnnotation[]          @relation("StudyAnnotationReviewer")
  createdAnnotationSnapshots                                     AnnotationSnapshot[]       @relation("AnnotationSnapshotCreator")
  actedRefunds                                                   Refund[]                   @relation("RefundActor")
  financialAuditLogs                                             FinancialAuditLog[]        @relation("FinancialAuditActor")
  ownershipRequestsRequested                                     OwnershipCorrectionRequest[] @relation("CorrectionRequester")
  ownershipLogsActed                                             OwnershipCorrectionLog[]     @relation("CorrectionActor")
  compensationEntries                                            DentistCompensationEntry[]  @relation("DentistCompensation")
  ownedSettlements                                               PaymentSettlement[]          @relation("SettlementOwnerDentist")

  @@index([clinic_id], map: "idx_users_clinic_id")
  @@index([lastLoginAt], map: "idx_users_last_login_at")
  @@map("users")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token], map: "idx_refresh_tokens_token")
  @@map("refresh_tokens")
}

model DentistProfile {
  id                          BigInt                        @id @default(autoincrement())
  userId                      BigInt                        @map("user_id")
  title                       String
  licenseNumber               String                        @unique @map("license_number")
  licenseIssuingBody          String                        @map("license_issuing_body")
  licenseExpiryDate           DateTime                      @map("license_expiry_date") @db.Date
  registrationNumber          String                        @unique @map("registration_number")
  primarySpecialization       String                        @map("primary_specialization")
  educationQualification      String                        @map("education_qualification")
  yearsOfExperience           Int                           @map("years_of_experience")
  clinicName                  String                        @map("clinic_name")
  clinicAddress               String                        @map("clinic_address")
  clinicWorkingHours          String                        @map("clinic_working_hours")
  consultationTypes           String[]                      @default([]) @map("consultation_types")
  servicesOffered             String[]                      @default([]) @map("services_offered")
  consultationFee             Int?                          @map("consultation_fee")
  acceptsInsurance            Boolean                       @default(false) @map("accepts_insurance")
  acceptsBpjs                 Boolean                       @default(false) @map("accepts_bpjs")
  emergencyAvailability       Boolean                       @default(false) @map("emergency_availability")
  isVerified                  Boolean                       @default(false) @map("is_verified")
  verificationDate            DateTime?                     @map("verification_date") @db.Timestamptz(6)
  createdAt                   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sipFilePath                 String?                       @map("sip_file_path")
  strFilePath                 String?                       @map("str_file_path")
  ijazahFilePaths             String[]                      @default([]) @map("ijazah_file_paths")
  certificationFilePaths      String[]                      @default([]) @map("certification_file_paths")
  avatar_url                  String?
  latitude                    Decimal?                      @db.Decimal(10, 8)
  longitude                   Decimal?                      @db.Decimal(11, 8)
  city                        String?
  district                    String?
  province                    String?
  postal_code                 String?
  dentist_type                String                        @default("independent")
  clinic_id                   BigInt?
  is_clinic_owner             Boolean?                      @default(false)
  storage_limit               BigInt                        @default(10737418240) @map("storage_limit")
  storage_usage               BigInt                        @default(0) @map("storage_usage")
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dentist_services            dentist_services[]
  service_dentist_assignments service_dentist_assignments[]

  @@index([licenseNumber], map: "idx_dentist_profiles_license_number")
  @@index([registrationNumber], map: "idx_dentist_profiles_registration_number")
  @@index([primarySpecialization], map: "idx_dentist_profiles_specialization")
  @@index([userId], map: "idx_dentist_profiles_user_id")
  @@index([city, district], map: "idx_dentist_city_district")
  @@index([clinic_id], map: "idx_dentist_clinic_id")
  @@index([latitude, longitude], map: "idx_dentist_location")
  @@index([dentist_type], map: "idx_dentist_type")
  @@map("dentist_profiles")
}

model ClinicProfile {
  id                         BigInt         @id @default(autoincrement())
  userId                     BigInt         @map("user_id")
  legalName                  String         @map("legal_name") @db.VarChar
  brandName                  String?        @map("brand_name") @db.VarChar
  facilityType               String         @map("facility_type") @db.VarChar
  streetAddress              String         @map("street_address") @db.VarChar
  city                       String         @db.VarChar
  province                   String         @db.VarChar
  postalCode                 String         @map("postal_code") @db.VarChar
  phone                      String         @db.VarChar
  email                      String         @db.VarChar
  timezone                   String         @default("Asia/Jakarta") @db.VarChar
  operatingHours             Json           @map("operating_hours")
  ownerName                  String         @map("owner_name") @db.VarChar
  ownerPosition              String         @map("owner_position") @db.VarChar
  ownerEmail                 String         @map("owner_email") @db.VarChar
  ownerWhatsapp              String         @map("owner_whatsapp") @db.VarChar
  ownerNik                   String         @unique @map("owner_nik") @db.VarChar
  ktpFilePath                String         @map("ktp_file_path") @db.VarChar
  ktpSelfieFilePath          String?        @map("ktp_selfie_file_path") @db.VarChar
  nibNumber                  String         @unique @map("nib_number") @db.VarChar
  nibFilePath                String         @map("nib_file_path") @db.VarChar
  npwpNumber                 String         @unique @map("npwp_number") @db.VarChar
  npwpFilePath               String         @map("npwp_file_path") @db.VarChar
  operationalLicenseFilePath String         @map("operational_license_file_path") @db.VarChar
  additionalLicenseFilePaths String[]       @default([]) @map("additional_license_file_paths")
  termsAccepted              Boolean        @default(false) @map("terms_accepted")
  privacyAccepted            Boolean        @default(false) @map("privacy_accepted")
  dataProtectionContact      String?        @map("data_protection_contact") @db.VarChar
  isVerified                 Boolean        @default(false) @map("is_verified")
  verificationDate           DateTime?      @map("verification_date") @db.Timestamptz(6)
  verificationNotes          String?        @map("verification_notes")
  status                     String         @default("pending") @db.VarChar
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  latitude                   Decimal?       @db.Decimal(10, 8)
  longitude                  Decimal?       @db.Decimal(11, 8)
  district                   String?
  branches                   ClinicBranch[]
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff                      ClinicStaff[]
  ownedPaymentIntents        PaymentIntent[]     @relation("PaymentIntentOwnerClinic")
  financialLedgerEntries     FinancialLedgerEntry[] @relation("FinancialLedgerClinic")
  invoices                   Invoice[]          @relation("InvoiceOwnerClinic")
  ownedAppointments          Appointment[]
  ownedSettlements           PaymentSettlement[]          @relation("SettlementOwnerClinic")
  compensationEntries        DentistCompensationEntry[]  @relation("ClinicCompensation")

  @@index([userId], map: "idx_clinic_profiles_user_id")
  @@index([nibNumber], map: "idx_clinic_profiles_nib")
  @@index([npwpNumber], map: "idx_clinic_profiles_npwp")
  @@index([ownerNik], map: "idx_clinic_profiles_owner_nik")
  @@index([status], map: "idx_clinic_profiles_status")
  @@index([legalName], map: "idx_clinic_profiles_legal_name")
  @@index([city, district], map: "idx_clinic_profiles_city")
  @@index([latitude, longitude], map: "idx_clinic_profiles_location")
  @@map("clinic_profiles")
}

model ClinicBranch {
  id                  BigInt              @id @default(autoincrement())
  clinicProfileId     BigInt              @map("clinic_profile_id")
  branchName          String              @map("branch_name") @db.VarChar
  branchCode          String?             @map("branch_code") @db.VarChar
  isMainBranch        Boolean             @default(false) @map("is_main_branch")
  streetAddress       String              @map("street_address") @db.VarChar
  city                String              @db.VarChar
  province            String              @db.VarChar
  postalCode          String              @map("postal_code") @db.VarChar
  phone               String?             @db.VarChar
  treatmentRoomsCount Int                 @map("treatment_rooms_count")
  hasSterlization     Boolean             @default(false) @map("has_sterilization")
  hasRadiography      Boolean             @default(false) @map("has_radiography")
  operatingHours      Json?               @map("operating_hours")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  latitude            Decimal?            @db.Decimal(10, 8)
  longitude           Decimal?            @db.Decimal(11, 8)
  district            String?
  appointments        Appointment[]
  clinicProfile       ClinicProfile       @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinic_facilities   clinic_facilities[]
  clinic_gallery      clinic_gallery[]
  clinic_highlights   clinic_highlights[]
  clinic_services     clinic_services[]
  clinicStaff         ClinicStaff[]

  @@unique([clinicProfileId, branchCode])
  @@index([clinicProfileId], map: "idx_clinic_branches_clinic_id")
  @@index([isMainBranch], map: "idx_clinic_branches_main")
  @@index([isActive], map: "idx_clinic_branches_active")
  @@index([city, district], map: "idx_clinic_branches_city")
  @@index([latitude, longitude], map: "idx_clinic_branches_location")
  @@map("clinic_branches")
}

model ClinicStaff {
  id               BigInt        @id @default(autoincrement())
  clinicProfileId  BigInt        @map("clinic_profile_id")
  userId           BigInt        @unique(map: "unique_clinic_staff_user_id") @map("user_id")
  role             String        @db.VarChar
  isActive         Boolean       @default(true) @map("is_active")
  hireDate         DateTime?     @map("hire_date") @db.Date
  positionTitle    String?       @map("position_title") @db.VarChar
  department       String?       @db.VarChar
  assignedBranchId BigInt?       @map("assigned_branch_id")
  permissions      Json?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedBranch   ClinicBranch? @relation(fields: [assignedBranchId], references: [id], onUpdate: NoAction)
  clinicProfile    ClinicProfile @relation(fields: [clinicProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([clinicProfileId, userId])
  @@index([clinicProfileId], map: "idx_clinic_staff_clinic_id")
  @@index([role], map: "idx_clinic_staff_role")
  @@index([isActive], map: "idx_clinic_staff_active")
  @@index([assignedBranchId], map: "idx_clinic_staff_branch")
  @@index([userId], map: "idx_clinic_staff_user_id")
  @@map("clinic_staff")
}

model PatientProfile {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @unique @map("user_id")
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  gender            String?
  insuranceProvider String?   @map("insurance_provider")
  insuranceNumber   String?   @map("insurance_number")
  insuranceMemberId String?   @map("insurance_member_id")
  emergencyContact  Json?     @map("emergency_contact")
  address           Json?
  medicalDetails    Json?     @map("medical_details")
  preferredLanguage String          @default("id") @map("preferred_language")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatmentPlans    TreatmentPlan[] @relation("PatientProfileTreatmentPlans")

  @@index([userId], map: "idx_patient_profiles_user_id")
  @@index([insuranceNumber], map: "idx_patient_profiles_insurance_number")
  @@map("patient_profiles")
}

model Appointment {
  id                 BigInt                     @id @default(autoincrement())
  dentistId          BigInt                     @map("dentist_id")
  patientId          BigInt                     @map("patient_id")
  clinicBranchId     BigInt?                    @map("clinic_branch_id")
  /// Financial transaction owner: "clinic" or "dentist" (independent dentist).
  ownerType          String                     @default("dentist") @map("owner_type") @db.VarChar(24)
  ownerClinicId      BigInt?                    @map("owner_clinic_id")
  startsAt           DateTime                   @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime                   @map("ends_at") @db.Timestamptz(6)
  status             String                     @default("scheduled") @db.VarChar
  reason             String?
  notes              String?
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chatRoomRef        String?                    @map("chat_room_ref")
  videoRoomRef       String?                    @map("video_room_ref")
  video_room_sid     String?
  commStatus         String                     @default("pending") @map("comm_status") @db.VarChar
  cancellationReason String?                    @map("cancellation_reason") @db.VarChar
  cancellationFee    Int?                       @map("cancellation_fee")
  rescheduledFromId  BigInt?                    @map("rescheduled_from_id")
  metadata           Json?                      @default("{}")
  consultationType   String?                    @default("onsite") @map("consultation_type") @db.VarChar
  statusHistory      AppointmentStatusHistory[]
  clinicBranch       ClinicBranch?              @relation(fields: [clinicBranchId], references: [id], onUpdate: NoAction)
  ownerClinic        ClinicProfile?             @relation(fields: [ownerClinicId], references: [id], onUpdate: NoAction)
  dentist            User                       @relation("DentistAppointments", fields: [dentistId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient            User                       @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rescheduledFrom    Appointment?               @relation("AppointmentRescheduleChain", fields: [rescheduledFromId], references: [id], onUpdate: NoAction)
  rescheduledTo      Appointment[]              @relation("AppointmentRescheduleChain")
  chatRoom           ChatRoom?
  paymentIntents     PaymentIntent[]            @relation("AppointmentPaymentIntents")
  invoices           Invoice[]                  @relation("AppointmentInvoices")
  financialEntries   FinancialLedgerEntry[]
  videoSessions      VideoSession[]
  communicationEvents CommunicationEvent[]
  compensationEntries DentistCompensationEntry[]
  clinicalSummary    AppointmentClinicalSummary?
  communicationParticipants AppointmentCommunicationParticipant[]
  followUpTasks      AppointmentFollowUpTask[]
  preSessionHealthForm AppointmentPreSessionHealthForm?

  @@index([dentistId, startsAt], map: "idx_appointments_dentist_time")
  @@index([patientId, startsAt], map: "idx_appointments_patient_time")
  @@index([status], map: "idx_appointments_status")
  @@index([commStatus], map: "idx_appointments_comm_status")
  @@map("appointments")
}

model AppointmentPreSessionHealthForm {
  id            BigInt      @id @default(autoincrement())
  appointmentId BigInt     @unique @map("appointment_id")
  patientId     BigInt     @map("patient_id")
  symptoms      String?
  painLevel     Int?       @map("pain_level")
  allergies     String?
  medications   String?
  notes         String?
  answers       Json?      @default("{}")
  submittedAt   DateTime   @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patientId, submittedAt], map: "idx_pre_session_health_forms_patient_submitted")
  @@map("appointment_pre_session_health_forms")
}

model AppointmentStatusHistory {
  id             BigInt      @id @default(autoincrement())
  appointmentId  BigInt      @map("appointment_id")
  previousStatus String?     @map("previous_status") @db.VarChar
  newStatus      String      @map("new_status") @db.VarChar
  changedBy      BigInt?     @map("changed_by")
  changedByRole  String?     @map("changed_by_role") @db.VarChar
  reason         String?     @db.VarChar
  notes          String?
  metadata       Json?       @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedByUser  User?       @relation(fields: [changedBy], references: [id], onUpdate: NoAction)

  @@index([appointmentId, createdAt(sort: Desc)], map: "idx_appointment_status_history_appt")
  @@index([changedBy], map: "idx_appointment_status_history_user")
  @@map("appointment_status_history")
}

model PaymentIntent {
  id                BigInt          @id @default(autoincrement())
  appointmentId     BigInt          @map("appointment_id")
  activeAppointmentId BigInt?       @map("active_appointment_id")
  patientId         BigInt          @map("patient_id")
  /// Financial transaction owner: "clinic" or "dentist" (independent dentist).
  ownerType         String          @default("dentist") @map("owner_type") @db.VarChar(24)
  ownerClinicId     BigInt?         @map("owner_clinic_id")
  ownerDentistId    BigInt?         @map("owner_dentist_id")
  amount            Int
  currency          String          @default("IDR") @db.VarChar
  status            String          @default("pending") @db.VarChar
  provider          String?         @db.VarChar
  idempotencyKey    String?         @unique(map: "uniq_payment_intents_idempotency_key") @map("idempotency_key") @db.VarChar(180)
  providerOrderId   String?         @unique(map: "uniq_payment_intents_provider_order_id") @map("provider_order_id") @db.VarChar(191)
  providerPaymentId String?         @unique(map: "uniq_payment_intents_provider_payment_id") @map("provider_payment_id") @db.VarChar
  metadata          Json?           @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  redirectUrl       String?         @map("redirect_url")
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz(6)
  providerResponse  Json?           @default("{}") @map("provider_response")
  reconciliationStatus String       @default("pending") @map("reconciliation_status") @db.VarChar(32)
  reconciliationAttempts Int        @default(0) @map("reconciliation_attempts")
  reconciliationError String?       @map("reconciliation_error") @db.VarChar(255)
  lastReconciledAt  DateTime?       @map("last_reconciled_at") @db.Timestamptz(6)
  callbackVerifiedAt DateTime?      @map("callback_verified_at") @db.Timestamptz(6)
  appointment       Appointment     @relation("AppointmentPaymentIntents", fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patient           User            @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ownerClinic       ClinicProfile?  @relation("PaymentIntentOwnerClinic", fields: [ownerClinicId], references: [id], onUpdate: NoAction)
  ownerDentist      User?           @relation("PaymentIntentOwnerDentist", fields: [ownerDentistId], references: [id], onUpdate: NoAction)
  ledgerEntries     PaymentLedger[]
  financialEntries  FinancialLedgerEntry[]
  invoices          Invoice[]       @relation("PaymentIntentInvoices")
  paymentSnapshot   PaymentSnapshot?
  refunds           Refund[]
  ownershipRequests OwnershipCorrectionRequest[]
  ownershipLogs     OwnershipCorrectionLog[]
  settlements       PaymentSettlement[]
  compensationEntries DentistCompensationEntry[]

  @@unique([activeAppointmentId], map: "uniq_payment_intents_active_appointment")
  @@index([appointmentId], map: "idx_payment_intents_appointment")
  @@index([patientId, createdAt(sort: Desc)], map: "idx_payment_intents_patient")
  @@index([status], map: "idx_payment_intents_status")
  @@index([ownerType, ownerClinicId], map: "idx_payment_intents_owner_clinic")
  @@index([ownerType, ownerDentistId], map: "idx_payment_intents_owner_dentist")
  @@index([providerOrderId], map: "idx_payment_intents_provider_order_id")
  @@index([providerPaymentId], map: "idx_payment_intents_provider_payment_id")
  @@index([reconciliationStatus, updatedAt(sort: Desc)], map: "idx_payment_intents_reconciliation")
  @@map("payment_intents")
}

model PaymentLedger {
  id              BigInt        @id @default(autoincrement())
  paymentIntentId BigInt        @map("payment_intent_id")
  entryType       String        @map("entry_type") @db.VarChar
  status          String        @db.VarChar
  amount          Int
  metadata        Json?         @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([paymentIntentId, status], map: "idx_payment_ledgers_intent_status")
  @@index([createdAt(sort: Desc)], map: "idx_payment_ledgers_created_at")
  @@map("payment_ledgers")
}

model FinancialLedgerEntry {
  id              BigInt        @id @default(autoincrement())
  paymentIntentId BigInt?       @map("payment_intent_id")
  appointmentId   BigInt?       @map("appointment_id")
  /// Financial transaction owner: "clinic" or "dentist" (independent dentist).
  ownerType       String        @map("owner_type") @db.VarChar(24)
  ownerClinicId   BigInt?       @map("owner_clinic_id")
  ownerDentistId  BigInt?       @map("owner_dentist_id")
  entryType       String        @map("entry_type") @db.VarChar(32)
  status          String        @db.VarChar(32)
  direction       String        @db.VarChar(16)
  amount          Int
  currency        String        @default("IDR") @db.VarChar(8)
  source          String?       @db.VarChar(32)
  metadata        Json?         @default("{}")
