  newOwnerClinicId      BigInt?                @map("new_owner_clinic_id")
  newOwnerDentistId     BigInt?                @map("new_owner_dentist_id")
  reason                String                 @db.VarChar(255)
  timestamp             DateTime               @default(now()) @db.Timestamptz(6)

  paymentIntent         PaymentIntent          @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  request               OwnershipCorrectionRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  actor                 User                   @relation("CorrectionActor", fields: [correctedBy], references: [id])

  @@map("ownership_correction_logs")
}

model PaymentSettlement {
  id                    BigInt                 @id @default(autoincrement())
  paymentIntentId       BigInt                 @map("payment_intent_id")
  ownerType             String                 @map("owner_type") @db.VarChar(24)
  ownerClinicId         BigInt?                @map("owner_clinic_id")
  ownerDentistId        BigInt?                @map("owner_dentist_id")
  grossAmount           Int                    @map("gross_amount")
  platformFee           Int                    @map("platform_fee")
  netAmount             Int                    @map("net_amount")
  currency              String                 @default("IDR") @db.VarChar(8)
  settlementStatus      String                 @map("settlement_status") @db.VarChar(32) // pending, processing, settled, failed, refunded, partially_refunded, chargeback
  providerReference     String?                @map("provider_reference") @db.VarChar(191)
  settledAt             DateTime?              @map("settled_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentIntent         PaymentIntent          @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  ownerClinic           ClinicProfile?         @relation("SettlementOwnerClinic", fields: [ownerClinicId], references: [id], onUpdate: NoAction)
  ownerDentist          User?                  @relation("SettlementOwnerDentist", fields: [ownerDentistId], references: [id], onUpdate: NoAction)

  @@index([ownerType, ownerClinicId], map: "idx_settlements_clinic")
  @@index([ownerType, ownerDentistId], map: "idx_settlements_dentist")
  @@map("payment_settlements")
}

model DentistCompensationEntry {
  id                    BigInt                 @id @default(autoincrement())
  appointmentId         BigInt?                @map("appointment_id")
  paymentIntentId       BigInt?                @map("payment_intent_id")
  dentistId             BigInt                 @map("dentist_id")
  clinicId              BigInt                 @map("clinic_id")
  entryType             String                 @map("entry_type") @db.VarChar(32) // ACCRUAL, COMMISSION, ADJUSTMENT, PAYOUT
  amount                Int
  status                String                 @default("accrued") @db.VarChar(32) // accrued, approved, paid, cancelled
  metadata              Json?                  @default("{}")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointment           Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  paymentIntent         PaymentIntent?         @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  dentist               User                   @relation("DentistCompensation", fields: [dentistId], references: [id], onDelete: Cascade)
  clinic                ClinicProfile          @relation("ClinicCompensation", fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([dentistId, status], map: "idx_compensation_dentist_status")
  @@index([clinicId, status], map: "idx_compensation_clinic_status")
  @@map("dentist_compensation_entries")
}

model WebhookProcessingLog {
  id                    BigInt                 @id @default(autoincrement())
  provider              String                 @db.VarChar(32)
  eventId               String                 @map("event_id") @db.VarChar(191)
  payloadHash           String                 @unique @map("payload_hash") @db.VarChar(128)
  receivedAt            DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId], map: "uniq_webhook_provider_event")
  @@map("webhook_processing_logs")
}
