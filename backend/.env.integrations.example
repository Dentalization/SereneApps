# ========================================
# SereneApps Backend - Final Provider Env
# ========================================

# Core
NODE_ENV=development
PORT=4000
API_VERSION=v1
DATABASE_URL=postgresql://serene:serene@localhost:5432/serene
CORS_ORIGINS=http://localhost:3000,http://localhost:4028
JWT_SECRET=replace-with-a-long-random-secret
JSON_BODY_LIMIT=512kb

# Observability
LOG_LEVEL=info
APP_ENV=local
APP_REGION=ap-southeast-3
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sereneapps-backend
OTEL_ENABLED=false

# Internal Eventing / Idempotency
EVENT_OUTBOX_BATCH_SIZE=100
EVENT_OUTBOX_POLL_INTERVAL_MS=3000
EVENT_MAX_RETRY=12
WEBHOOK_MAX_RETRY=10
IDEMPOTENCY_TTL_HOURS=72

# Appointment Guardrails
APPOINTMENT_RESCHEDULE_CUTOFF_HOURS=24
APPOINTMENT_CANCEL_CUTOFF_HOURS=12
APPOINTMENT_CANCELLATION_FEE_PERCENT=0

# OTP Policy
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_HASH_SECRET=replace-with-dedicated-otp-hash-secret
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=30
OTP_IP_WINDOW_SECONDS=3600
OTP_IP_MAX_REQUESTS=20
OTP_IDENTIFIER_WINDOW_SECONDS=3600
OTP_IDENTIFIER_MAX_REQUESTS=5
OTP_DEV_RETURN_CODE=false
OTP_EMAIL_DEPRECATED=true

# Twilio Account
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Twilio Conversations
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_CONVERSATIONS_WEBHOOK_SECRET=
TWILIO_CONVERSATIONS_WEBHOOK_BASE_URL=https://api.example.com/v1/webhooks/twilio/conversations

# Twilio Video
TWILIO_VIDEO_API_KEY_SID=
TWILIO_VIDEO_API_KEY_SECRET=
TWILIO_VIDEO_STATUS_CALLBACK_SECRET=
TWILIO_VIDEO_RECORDINGS_ENABLED=false
TWILIO_VIDEO_DEFAULT_ROOM_TYPE=group-small
TWILIO_VIDEO_MAX_PARTICIPANTS=2

# Midtrans Snap
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_BASE_URL=https://app.sandbox.midtrans.com
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_MOCK_MODE=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_SNAP_CALLBACK_URL=https://api.example.com/v1/payments/webhooks/midtrans
MIDTRANS_FINISH_URL=https://app.example.com/payment/finish
MIDTRANS_PENDING_URL=https://app.example.com/payment/pending
MIDTRANS_ERROR_URL=https://app.example.com/payment/error
MIDTRANS_RECONCILIATION_CRON=*/15 * * * *

# Firebase FCM
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
FCM_ANDROID_TTL_SECONDS=3600
FCM_IOS_APNS_TOPIC=

# Notification Delivery
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=300
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true

# Optional Email Channel
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@sereneapps.com
