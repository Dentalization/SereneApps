# ========================================
# SereneAI Backend - STAGING Environment
# ========================================
# Copy this file and fill in the values for Railway deployment

# ----------------------------------------
# Database (Auto-generated by Railway)
# ----------------------------------------
# Get this from Railway PostgreSQL service
DATABASE_URL=postgresql://user:password@host:port/database

# ----------------------------------------
# API Configuration
# ----------------------------------------
NODE_ENV=staging
PORT=4000
API_VERSION=v1

# ----------------------------------------
# JWT Secrets (GENERATE NEW ONES!)
# ----------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ----------------------------------------
# CORS Configuration
# ----------------------------------------
# Add your frontend staging URL here
CORS_ORIGINS=https://sereneai-staging.vercel.app,http://localhost:4028

# ----------------------------------------
# OTP Configuration
# ----------------------------------------
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ----------------------------------------
# Twilio SMS (Optional for dev/staging)
# ----------------------------------------
# Leave empty to use dev mode (OTP logged to console)
# For production, get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----------------------------------------
# SendGrid Email (Optional for dev/staging)
# ----------------------------------------
# Leave empty to use dev mode (OTP logged to console)
# For production, get from: https://app.sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sereneai.com

# ----------------------------------------
# Firebase (Optional - Push Notifications)
# ----------------------------------------
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ----------------------------------------
# Agora (Optional - Video Calls)
# ----------------------------------------
# Get from: https://console.agora.io
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ========================================
# NOTES:
# ========================================
# 1. DO NOT commit this file with real secrets to git
# 2. Add .env.staging to .gitignore
# 3. Set these in Railway dashboard under "Variables"
# 4. JWT secrets MUST be different from production
# 5. Twilio/SendGrid optional - app works in dev mode without them
# 6. Firebase/Agora can be added later when needed
