# Paper evidence experiment configuration.
# Copy values into your shell or local .env loader; do not commit real secrets.

# Backend API used by k6 and X-Core upload benchmark.
API_URL=http://localhost:4000/v1
BASE_URL=http://localhost:4000/v1

# Python X-Core/CDSS service.
PYTHON_SERVICE_URL=http://localhost:8000

# Synthetic benchmark credentials. Use non-production test accounts only.
TEST_PATIENT_EMAIL=patient.test@example.local
TEST_PATIENT_PASSWORD=change-me
TEST_DENTIST_EMAIL=dentist.test@example.local
TEST_DENTIST_PASSWORD=change-me

# Optional known appointment for load/chat tests.
APPOINTMENT_ID=

# CDSS benchmark settings.
CDSS_RUNS=30
CDSS_CONCURRENCY=2,5,10
CDSS_POLL_INTERVAL_MS=500
CDSS_TIMEOUT_MS=120000
CDSS_CLEANUP=true
CDSS_FIXTURE_DIR=paper-evidence/fixtures/synthetic_dental_images

# Load test settings.
LOAD_VUS=100,200
DURATION=5m

# Set to true to write traceable not_run files when local services are unavailable.
WRITE_NOT_RUN=true
