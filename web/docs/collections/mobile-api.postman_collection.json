{
  "info": {
    "name": "SereneAI Mobile API",
    "description": "Collection covering auth, appointments, payments, and communications flows for the mobile client.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Patient\",\n  \"email\": \"jane+mobile@example.com\",\n  \"password\": \"Secret123!\",\n  \"phoneNumber\": \"+6281234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/patient/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "patient", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane+mobile@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments?view=patient&includeHistory=true",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"],
              "query": [
                { "key": "view", "value": "patient" },
                { "key": "includeHistory", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dentistId\": \"1\",\n  \"start\": \"2024-12-01T09:00:00.000Z\",\n  \"end\": \"2024-12-01T09:30:00.000Z\",\n  \"reason\": \"Nyeri gigi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            }
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startsAt\": \"2024-12-02T09:00:00.000Z\",\n  \"endsAt\": \"2024-12-02T09:30:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/reschedule",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentId}}", "reschedule"]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Sakit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", "{{appointmentId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"amount\": 150000,\n  \"currency\": \"IDR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"succeeded\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentIntentId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{paymentIntentId}}", "confirm"]
            }
          }
        }
      ]
    },
    {
      "name": "Communications",
      "item": [
        {
          "name": "Send Chat Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Halo dokter\",\n  \"messageType\": \"text\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/communications/appointments/{{appointmentId}}/chat/messages",
              "host": ["{{baseUrl}}"],
              "path": ["communications", "appointments", "{{appointmentId}}", "chat", "messages"]
            }
          }
        },
        {
          "name": "Video Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"publisher\",\n  \"expireSeconds\": 3600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/communications/appointments/{{appointmentId}}/video/token",
              "host": ["{{baseUrl}}"],
              "path": ["communications", "appointments", "{{appointmentId}}", "video", "token"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "paymentIntentId", "value": "" }
  ]
}
