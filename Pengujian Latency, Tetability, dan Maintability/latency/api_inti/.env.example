# Salin sebagai .env untuk penggunaan shell lokal, lalu isi seluruh placeholder.
# Jangan commit file .env atau membagikan nilai asli.
BASE_URL=http://127.0.0.1:4000
API_PREFIX=/v1
PATIENT_EMAIL=patient-test@example.com
PATIENT_PASSWORD=replace-with-patient-password
DENTIST_EMAIL=dentist-test@example.com
DENTIST_PASSWORD=replace-with-dentist-password
DENTIST_PROFILE_ID=replace-with-dentist-profile-id
# Opsional: gunakan appointment fixture yang sudah tervalidasi.
APPOINTMENT_ID=
CLINIC_BRANCH_ID=
SAMPLE_IMAGE_PATH=fixtures/sample-dental.jpg
RUNS=3
VUS=10
DURATION=3m
COOLDOWN_SECONDS=600
FORCE=0
ALLOW_REMOTE_TARGET=0
