{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requested scan experiment settings; observed settings are stored separately",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "captureProtocol": {
      "type": "string"
    },
    "capture": {
      "type": "object",
      "description": "Requested capture settings; never proof of device output"
    },
    "cameraIntrinsics": {
      "type": "object",
      "required": [
        "fx",
        "fy",
        "cx",
        "cy"
      ],
      "additionalProperties": false,
      "properties": {
        "fx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        },
        "distortion": {
          "type": "array",
          "description": "Optional OpenCV [k1,k2,p1,p2,(k3)] coefficients for this exact lens, resolution and orientation; operator-supplied until independently verified",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 5
        }
      }
    },
    "frameSampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": ["uniform", "geometry_aware"],
          "description": "uniform is global-image diagnostic only and cannot mark capture ready"
        },
        "maxFrames": {
          "type": "integer",
          "minimum": 2,
          "maximum": 120
        },
        "minSharpness": {
          "type": "number",
          "minimum": 0
        },
        "minLuminance": {
          "type": "number",
          "minimum": 0
        },
        "maxLuminance": {
          "type": "number",
          "minimum": 0
        },
        "minPixelDifference": {
          "type": "number",
          "minimum": 0
        },
        "dentalRegions": {
          "type": "object",
          "description": "Auditable manually reviewed frame polygons bound to the source video hash. Client declaration does not by itself prove anatomical identity.",
          "required": ["source", "reviewer", "videoSha256", "expectedRegions", "frames"],
          "properties": {
            "source": { "const": "operator_annotated_unverified" },
            "reviewer": { "type": "string", "minLength": 1 },
            "videoSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "expectedRegions": { "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 } },
            "expectedToothIds": { "type": "array", "uniqueItems": true, "maxItems": 32,
              "description": "Optional reviewer-declared FDI identifiers; not independently verified tooth identity",
              "items": { "type": "integer", "minimum": 11, "maximum": 48 } },
            "frames": { "type": "array", "minItems": 2, "maxItems": 120,
              "items": { "type": "object", "required": ["frameIndex", "polygon", "mouthStable", "visibleRegions"],
                "properties": {
                  "frameIndex": { "type": "integer", "minimum": 0 },
                  "polygon": { "type": "array", "minItems": 3, "maxItems": 64,
                    "items": { "type": "array", "prefixItems": [
                      { "type": "number", "minimum": 0, "maximum": 1 },
                      { "type": "number", "minimum": 0, "maximum": 1 }
                    ], "minItems": 2, "maxItems": 2 } },
                  "mouthStable": { "type": "boolean" },
                  "visibleRegions": { "type": "array", "items": { "type": "string" } },
                  "toothRegions": { "type": "array", "maxItems": 32,
                    "items": { "type": "object", "required": ["fdi", "polygon"],
                      "properties": {
                        "fdi": { "type": "integer", "minimum": 11, "maximum": 48 },
                        "polygon": { "type": "array", "minItems": 3, "maxItems": 64,
                          "items": { "type": "array", "prefixItems": [
                            { "type": "number", "minimum": 0, "maximum": 1 },
                            { "type": "number", "minimum": 0, "maximum": 1 }
                          ], "minItems": 2, "maxItems": 2 } }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "enum": [
            "opencv_sparse_sfm",
            "python_reconstruction_service"
          ]
        },
        "parameters": {
          "type": "object",
          "description": "Runtime validates bounds in reconstruction_service.DEFAULT_CONFIG",
          "additionalProperties": false,
          "properties": {
            "maxViews": {
              "type": "number"
            },
            "maxImageDimension": {
              "type": "number"
            },
            "maxFeatures": {
              "type": "number"
            },
            "ratioThreshold": {
              "type": "number"
            },
            "ransacThresholdPx": {
              "type": "number"
            },
            "maxReprojectionErrorPx": {
              "type": "number"
            },
            "minPoints": {
              "type": "number"
            },
            "minParallaxDegrees": {
              "type": "number"
            },
            "maxTriangleEdgePixels": {
              "type": "number"
            },
            "maxTriangleDepthRatio": {
              "type": "number"
            },
            "seed": {
              "type": "number"
            }
          }
        }
      }
    },
    "postProcessing": {
      "type": "object",
      "properties": {
        "enabled": {
          "const": false
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "registration": {
          "enum": [
            "none",
            "rigid",
            "rigid_icp"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
