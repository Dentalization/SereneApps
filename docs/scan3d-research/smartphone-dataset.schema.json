{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 13A smartphone study manifest; availability is verified separately",
  "type": "object",
  "required": [
    "protocolId",
    "captures",
    "references"
  ],
  "properties": {
    "protocolId": {
      "type": "string",
      "minLength": 1
    },
    "captures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "captureId",
          "objectId",
          "sessionId",
          "operatorId",
          "device",
          "video",
          "metadata",
          "referenceId"
        ],
        "properties": {
          "captureId": {
            "type": "string",
            "minLength": 1
          },
          "objectId": {
            "type": "string",
            "minLength": 1
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "operatorId": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "referenceId": {
            "type": "string",
            "minLength": 1
          },
          "video": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "metadata": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "referenceId",
          "objectId",
          "mesh",
          "metadata"
        ],
        "properties": {
          "referenceId": {
            "type": "string"
          },
          "objectId": {
            "type": "string"
          },
          "mesh": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "metadata": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "description": "Manifest contract only. Requires human-approved object/reference pairing, independently measured scale, reference uncertainty, exclusions and runtime hash checks before evaluation. Repeated CBCT software runs never satisfy capture count."
}
