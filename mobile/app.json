{
  "expo": {
    "name": "Serene Dental Patient",
    "slug": "serene-dental-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan Serene Dental Patient mengakses lokasi Anda untuk menemukan klinik dan dokter terdekat.",
          "locationAlwaysAndWhenInUsePermission": "Izinkan Serene Dental Patient mengakses lokasi Anda untuk menemukan klinik dan dokter terdekat."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sereneapps.dentalpatient"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.sereneapps.dentalpatient",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F172A"
    },
    "web": {}
  }
}