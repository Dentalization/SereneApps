# SereneAI Mobile App - Environment Variables
# Copy this file to .env and fill in the real values

# ============================================
# AI DIAGNOSIS API (DeepDental)
# ============================================

# Production Cloud API (Default)
EXPO_PUBLIC_AI_URL=https://api.dentalization.id/api/v1
EXPO_PUBLIC_AI_KEY=dd_live_436cf81b52019841a9797fa5a12bb3b3

# AI Mode: 'local' for localhost testing, leave empty for cloud
# EXPO_PUBLIC_AI_MODE=local

# ============================================
# BACKEND API (SereneApps)
# ============================================

# Leave empty to use auto-detected localhost/IP
# EXPO_PUBLIC_BACKEND_URL=http://localhost:3000/api

# ============================================
# HOW TO GET API KEY
# ============================================
# 1. Contact admin for production API key, OR
# 2. Run in DeepDental project: python scripts/create_api_key.py
# 3. Copy the generated key (starts with dd_live_...)
# 4. Paste it in EXPO_PUBLIC_AI_KEY above

# ============================================
# TESTING MODES
# ============================================

# Production Cloud (Default):
#   EXPO_PUBLIC_AI_URL=https://api.dentalization.id/api/v1
#   EXPO_PUBLIC_AI_KEY=dd_live_xxxxxxxxxxxxx
#   (no EXPO_PUBLIC_AI_MODE)

# Local Development:
#   EXPO_PUBLIC_AI_MODE=local
#   (uses localhost:8000 or LOCAL_IP:8000)
